    "deploy": {
      "type": "script",
      "requires": [
        "node"
      ],
      "steps": [
        "git clone https://github.com/chenhuilin2/chaoxing-work-export.git",
        "cd chaoxing-work-export",
        "npm install",
        "npm run build",
        "ls -l dist"
      ],
      "stepsPs": [
        "git clone https://github.com/chenhuilin2/chaoxing-work-export.git",
        "Set-Location chaoxing-work-export",
        "npm install",
        "npm run build",
        "Get-ChildItem dist"
      ],
      "source": "https://github.com/chenhuilin2/chaoxing-work-export#development"
    },
    "pitfalls": [
      "npm install 失败：确认 Node 版本 ≥ 20",
      "构建报类型错误：先跑 `npm run typecheck` 看具体文件",
      "导入后无反应：确认当前页面是作业/考试/章节练习",
      "导出缺题：页面改版，等更新或调整选择器",
      "Word 图片丢失：确认浏览器允许跨域读取图片",
      "多章节合并失败：改为按章节拆分导出",
      "脚本与其它学习通脚本冲突：只保留一个启用"
    ]
  },
